PORT=3000
NODE_ENV=development
# Postgres connection string for production or Supabase. Leave it unset for local work: the app then uses PGlite, a Postgres inside the process, stored in PGDATA_DIR.
# Set it on the host or in your own .env only. Never write the real value into this file or any other committed file.
# DATABASE_URL=postgres://user:password@host:5432/postgres
# Certificate of the Postgres server as PEM text. Set it to verify the server; without it the connection is encrypted but the server is not verified.
# DATABASE_CA=
# Folder of the local PGlite database (default data/pgdata).
# PGDATA_DIR=data/pgdata
# Number of reverse proxies in front of the app (usually 1 on a host). Leave unset if there is none, or the rate limit can be dodged.
# TRUST_PROXY=1
